# Transportation Management System - Environment Variables
# Copy this to .env and adjust values as needed.

# Server configuration
HOST=0.0.0.0
PORT=3001
FLASK_DEBUG=true

# Secret key for Flask sessions (change in production!)
# SECRET_KEY=your-secret-key-here

# Database path (defaults to tms.db in the App directory)
# SQLITE_DB_PATH=/path/to/your/tms.db
